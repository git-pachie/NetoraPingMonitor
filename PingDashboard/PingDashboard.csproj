<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PingDashboard</RootNamespace>
    <UserSecretsId>pingdashboard-smtp-secrets</UserSecretsId>

    <!-- ── Resource / memory tuning ──────────────────────────────────────────
         Workstation GC keeps the memory footprint far smaller than the default
         Server GC (which pre-allocates a heap per CPU core). Ideal for a
         low-throughput monitoring app. Concurrent GC avoids UI pauses. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Trim the thread pool / tiered PGO overhead for a small service -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>false</TieredPGO>
    <!-- Don't ship the invariant-globalization ICU unless needed -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR"             Version="1.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"     Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"     Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
