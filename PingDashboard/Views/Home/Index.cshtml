@model IReadOnlyList<PingDashboard.Models.Client>
@{
    ViewData["Title"] = "Network Monitor";
}

@* ── Toast ──────────────────────────────────────────────────────────────────── *@
<div aria-live="polite" aria-atomic="true"
     style="position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:9999;min-width:280px;max-width:90vw;">
    <div id="toastBox" class="toast align-items-center border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@* ── Page header ─────────────────────────────────────────────────────────────── *@
<div class="d-flex flex-wrap align-items-start align-items-sm-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="mb-0 fw-bold">Network Monitor</h4>
        <small class="text-muted">Live status · <span id="clientCount">@Model.Count</span> client(s)</small>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="d-flex align-items-center gap-1">
            <label for="filterNapbox" class="text-muted small mb-0 d-none d-sm-inline">Napbox:</label>
            <select id="filterNapbox" class="form-select form-select-sm" style="min-width:150px">
                <option value="">All napboxes</option>
            </select>
        </div>
        <span id="connectionBadge" class="badge bg-secondary px-2 py-2 d-flex align-items-center gap-1">
            <span id="connectionDot" class="dot dot-secondary"></span>
            <span id="connectionText">Connecting…</span>
        </span>
        <span class="text-muted small d-none d-md-inline">
            Refreshed: <strong id="lastRefresh">—</strong>
        </span>
        @if (User.IsInRole("Admin"))
        {
            <button class="btn btn-sm btn-primary" id="btnAddClient">&#43; Add</button>
        }
    </div>
</div>

<script>
    window.isAdmin = @(User.IsInRole("Admin") ? "true" : "false");
    // null for Admin (no restriction); otherwise the array of allowed napbox names.
    window.allowedNapboxes = @(ViewBag.AllowedNapboxes is string[] arr
        ? "[" + string.Join(",", arr.Select(a => "\"" + a.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"")) + "]"
        : "null");
</script>

@* ── Known clients ────────────────────────────────────────────────────────────── *@
<div class="card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0" id="statusTable">
            <thead class="table-dark">
                <tr>
                    <th class="d-none d-sm-table-cell" style="width:40px">#</th>
                    <th id="th-name"   class="sortable">Name <span id="sort-icon-name"   class="sort-icon">⇅</span></th>
                    <th class="d-none d-md-table-cell">IP Address</th>
                    <th id="th-status" class="sortable">Status <span id="sort-icon-status" class="sort-icon">⇅</span></th>
                    <th id="th-napbox" class="sortable">Napbox <span id="sort-icon-napbox" class="sort-icon">⇅</span></th>
                    <th class="text-center" style="width:50px">Notify</th>
                    <th class="d-none d-lg-table-cell">Last Received Time</th>
                    <th class="text-center" style="width:90px">Actions</th>
                </tr>
            </thead>
            <tbody id="statusBody">
                @if (!Model.Any())
                {
                    <tr id="noDataRow">
                        <td colspan="8" class="text-center text-muted py-4">
                            No clients — click <strong>Add</strong> to get started.
                        </td>
                    </tr>
                }
                else
                {
                    int i = 1;
                    foreach (var c in Model)
                    {
                        <tr id="row-@c.Id" data-id="@c.Id" data-ip="@c.IpAddress" data-napbox="@c.NapboxName">
                            <td class="row-num d-none d-sm-table-cell">@(i++)</td>
                            <td class="client-name">
                                <span class="name-text">@c.Name</span>
                                @* On small screens show IP inline below name *@
                                <div class="d-md-none text-muted small client-ip-mobile">@c.IpAddress</div>
                                <div class="d-lg-none text-muted small client-time-mobile">—</div>
                            </td>
                            <td class="d-none d-md-table-cell"><code class="client-ip">@c.IpAddress</code></td>
                            <td class="client-status">
                                <span class="badge bg-secondary px-2 py-1">Unknown</span>
                            </td>
                            <td class="client-napbox text-muted small">@(string.IsNullOrEmpty(c.NapboxName) ? "—" : c.NapboxName)</td>
                            <td class="text-center client-notify">
                                @if (c.IsNotificationEnabled)
                                {
                                    <span class="bell-on"  title="Notifications ON: @c.NotifyEmail">🔔</span>
                                }
                                else
                                {
                                    <span class="bell-off" title="Notifications OFF">🔕</span>
                                }
                            </td>
                            <td class="d-none d-lg-table-cell text-muted small client-time">—</td>
                            <td class="text-center client-actions">
                                @if (User.IsInRole("Admin"))
                                {
                                    <button class="btn btn-xs btn-outline-primary me-1 btn-edit"
                                            data-id="@c.Id" data-name="@c.Name" data-ip="@c.IpAddress"
                                            data-email="@c.NotifyEmail" data-notify="@(c.IsNotificationEnabled ? "1" : "0")"
                                            data-napbox="@c.NapboxName">✏</button>
                                    <button class="btn btn-xs btn-outline-danger btn-delete"
                                            data-id="@c.Id" data-name="@c.Name">✕</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Unknown clients ──────────────────────────────────────────────────────────── *@
<div id="unknownSection" style="display:none">
    <h6 class="text-muted mb-2">
        <span class="badge bg-warning text-dark">?</span> Unknown Clients
        <small class="fw-normal ms-1">(IP not in database)</small>
    </h6>
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-warning">
                    <tr>
                        <th class="d-none d-sm-table-cell" style="width:40px">#</th>
                        <th>Label</th>
                        <th class="d-none d-md-table-cell">IP Address</th>
                        <th>Status</th>
                        <th class="d-none d-lg-table-cell">Last Received Time</th>
                        <th class="text-center" style="width:90px">Action</th>
                    </tr>
                </thead>
                <tbody id="unknownBody"></tbody>
            </table>
        </div>
    </div>
</div>

@* ── Add / Edit Modal ─────────────────────────────────────────────────────────── *@
<div class="modal fade" id="clientModal" tabindex="-1" aria-labelledby="clientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="clientModalLabel">Add Client</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId" value="0" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Name</label>
                    <input type="text" id="inputName" class="form-control"
                           placeholder="e.g. Google DNS Primary" maxlength="200"
                           autocomplete="off" />
                    <div class="invalid-feedback" id="nameError"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">IP Address / Hostname</label>
                    <input type="text" id="inputIp" class="form-control"
                           placeholder="e.g. 8.8.8.8 or host.example.com" maxlength="100"
                           autocomplete="off" inputmode="url" />
                    <div class="invalid-feedback" id="ipError"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Napbox</label>
                    <select id="inputNapbox" class="form-select">
                        <option value="">— None —</option>
                    </select>
                    <div class="form-text">
                        Manage the list on the <a asp-controller="Napbox" asp-action="Index">Napbox</a> page.
                    </div>
                </div>

                <hr />
                <h6 class="text-muted mb-3">🔔 Notifications</h6>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="inputNotifyEnabled" />
                    <label class="form-check-label fw-semibold" for="inputNotifyEnabled">
                        Enable notifications for this client
                    </label>
                </div>

                <div class="mb-1">
                    <label class="form-label fw-semibold">Notify Email(s)</label>
                    <input type="text" id="inputNotifyEmail" class="form-control"
                           placeholder="email1@example.com, email2@example.com" maxlength="1000"
                           autocomplete="off" />
                    <div class="form-text">Separate multiple addresses with commas.</div>
                    <div class="invalid-feedback" id="emailError"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/signalr.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
