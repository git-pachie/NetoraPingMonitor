@model IReadOnlyList<PingDashboard.Models.AppUser>
@{
    ViewData["Title"] = "User Management";
    var allNapboxes = ViewBag.AllNapboxes as List<string> ?? new List<string>();
}

@* ── Toast ──────────────────────────────────────────────────────────────────── *@
<div aria-live="polite" aria-atomic="true"
     style="position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:9999;min-width:280px;max-width:90vw;">
    <div id="toastBox" class="toast align-items-center border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@* ── Header ──────────────────────────────────────────────────────────────────── *@
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="mb-0 fw-bold">User Management</h4>
        <small class="text-muted"><span id="userCount">@Model.Count</span> user(s)</small>
    </div>
    <button class="btn btn-sm btn-primary" id="btnAddUser">&#43; Add User</button>
</div>

@* ── Table ───────────────────────────────────────────────────────────────────── *@
<div class="card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:50px">#</th>
                    <th style="width:56px"></th>
                    <th>Username</th>
                    <th class="d-none d-md-table-cell">Email</th>
                    <th class="d-none d-lg-table-cell">Mobile</th>
                    <th style="width:120px">Role</th>
                    <th class="d-none d-lg-table-cell">Napboxes</th>
                    <th class="text-center" style="width:140px">Actions</th>
                </tr>
            </thead>
            <tbody id="userBody">
                @if (!Model.Any())
                {
                    <tr id="noDataRow"><td colspan="8" class="text-center text-muted py-4">No users.</td></tr>
                }
                else
                {
                    int i = 1;
                    foreach (var u in Model)
                    {
                        var boxes = string.Join(", ", u.Napboxes.Select(n => n.NapboxName));
                        <tr id="usr-@u.Id" data-id="@u.Id">
                            <td class="row-num">@(i++)</td>
                            <td class="usr-avatar">
                                @if (!string.IsNullOrEmpty(u.ProfileImagePath))
                                {
                                    <img src="@u.ProfileImagePath" class="avatar" alt="" />
                                }
                                else
                                {
                                    <span class="avatar avatar-placeholder">@(u.Username.Length > 0 ? u.Username[0].ToString().ToUpper() : "?")</span>
                                }
                            </td>
                            <td class="usr-name">@u.Username</td>
                            <td class="d-none d-md-table-cell usr-email text-muted small">@(string.IsNullOrEmpty(u.Email) ? "—" : u.Email)</td>
                            <td class="d-none d-lg-table-cell usr-mobile text-muted small">@(string.IsNullOrEmpty(u.Mobile) ? "—" : u.Mobile)</td>
                            <td class="usr-role">
                                @if (u.Role == PingDashboard.Models.Roles.Admin)
                                {
                                    <span class="badge bg-primary">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Technician</span>
                                }
                            </td>
                            <td class="d-none d-lg-table-cell usr-napboxes text-muted small">
                                @(u.Role == PingDashboard.Models.Roles.Admin ? "All" : (string.IsNullOrEmpty(boxes) ? "—" : boxes))
                            </td>
                            <td class="text-center">
                                <button class="btn btn-xs btn-outline-primary me-1 btn-edit" data-id="@u.Id">Edit</button>
                                <button class="btn btn-xs btn-outline-danger btn-delete"
                                        data-id="@u.Id" data-name="@u.Username">Del</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Add / Edit Modal ─────────────────────────────────────────────────────────── *@
<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userModalLabel">Add User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId" value="0" />

                @* Profile image *@
                <div class="d-flex align-items-center gap-3 mb-3">
                    <img id="imgPreview" src="" alt="" class="avatar avatar-lg" style="display:none" />
                    <span id="imgPlaceholder" class="avatar avatar-lg avatar-placeholder">?</span>
                    <div>
                        <label class="form-label fw-semibold mb-1">Profile Image</label>
                        <input type="file" id="inputImage" class="form-control form-control-sm" accept="image/*" />
                        <div class="form-text" id="imgHint">Saved after you upload (max 2 MB).</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Username</label>
                    <input type="text" id="inputUsername" class="form-control" maxlength="100" autocomplete="off" />
                    <div class="invalid-feedback" id="usernameError"></div>
                </div>
                <div class="row g-2">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" id="inputEmail" class="form-control" maxlength="200" autocomplete="off" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Mobile</label>
                        <input type="text" id="inputMobile" class="form-control" maxlength="50" autocomplete="off" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Password <small id="pwHint" class="text-muted fw-normal"></small></label>
                    <input type="password" id="inputPassword" class="form-control" autocomplete="new-password" />
                    <div class="invalid-feedback" id="passwordError"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Role</label>
                    <select id="inputRole" class="form-select">
                        <option value="Technician">Technician</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>

                @* Napbox assignment — only relevant for Technicians *@
                <div class="mb-1" id="napboxGroup">
                    <label class="form-label fw-semibold">Assigned Napboxes</label>
                    <div class="form-text mb-1">Technicians see only clients in these napboxes. Admins always see all.</div>
                    <div id="napboxChecks" class="border rounded p-2" style="max-height:160px; overflow:auto;">
                        @if (allNapboxes.Count == 0)
                        {
                            <div class="text-muted small">No napboxes yet. Create some on the Napbox page.</div>
                        }
                        else
                        {
                            foreach (var box in allNapboxes)
                            {
                                <div class="form-check">
                                    <input class="form-check-input napbox-check" type="checkbox" value="@box" id="nb_@box.GetHashCode()" />
                                    <label class="form-check-label" for="nb_@box.GetHashCode()">@box</label>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/users.js" asp-append-version="true"></script>
}
